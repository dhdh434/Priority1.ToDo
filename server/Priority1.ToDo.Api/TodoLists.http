@baseUrl = http://localhost:5000
@listId = 1
@todoId = 1

### Get all lists
GET {{baseUrl}}/lists

### Get a list
GET {{baseUrl}}/lists/{{listId}}

### Create a list
POST {{baseUrl}}/lists
Content-Type: application/json

{
  "name": "Weekend chores"
}

### Rename a list
PUT {{baseUrl}}/lists/{{listId}}
Content-Type: application/json

{
  "name": "Home chores"
}

### Delete a list and its todos
DELETE {{baseUrl}}/lists/{{listId}}

### Get todos in a list
GET {{baseUrl}}/lists/{{listId}}/todos

### Get a todo in a list
GET {{baseUrl}}/lists/{{listId}}/todos/{{todoId}}

### Create a todo in a list
POST {{baseUrl}}/lists/{{listId}}/todos
Content-Type: application/json

{
  "title": "Water the plants",
  "isComplete": false
}

### Update a todo in a list
PUT {{baseUrl}}/lists/{{listId}}/todos/{{todoId}}
Content-Type: application/json

{
  "title": "Water the plants",
  "isComplete": false,
  "dueDate": null
}

### Delete a todo from a list
DELETE {{baseUrl}}/lists/{{listId}}/todos/{{todoId}}
